# Copy to .env.docker and adjust. docker compose reads it via --env-file.
#   cp .env.docker.example .env.docker

# --- Database ---
POSTGRES_USER=endorium
POSTGRES_PASSWORD=endorium
POSTGRES_DB=endorium_nexus

# --- Domain identity ---
NEXUS_DOMAIN=endorium.local
NEXUS_REALM=ENDORIUM.LOCAL
NEXUS_DC_HOST=dc1

# --- LAN / macvlan (the DC's real LAN presence) ---
# NEXUS_DC_IP: the dedicated LAN IP the DC container owns (must be free on the LAN
# and inside LAN_SUBNET). Windows clients use this as their primary DNS + DC.
NEXUS_DC_IP=192.168.1.50
# MACVLAN_PARENT: the host NIC bridged to the LAN (run `ip -o link` to find it).
MACVLAN_PARENT=eth0
LAN_SUBNET=192.168.1.0/24
LAN_GATEWAY=192.168.1.1

# --- Web UI / API ---
NEXUS_HTTP_PUBLISH=8080
NEXUS_ADMIN_EMAIL=admin@endorium.local
# Platform admin login hash for the web UI. Generate it once:
#   docker compose run --rm --no-deps nexus-api nexusctl bootstrap-admin 'YourStrongPassword'
# then paste the printed hash here (keep the single quotes off; it may contain $).
NEXUS_ADMIN_PASSWORD_HASH=

# Optional: override the image tag/name
# NEXUS_IMAGE=endorium-nexus:latest
